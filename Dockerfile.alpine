FROM --platform=linux/amd64 oven/bun:slim AS build
WORKDIR /app

ARG GITHUB_SHA=development
ARG GITHUB_REF_NAME=development
ENV GITHUB_SHA=${GITHUB_SHA}
ENV GITHUB_REF_NAME=${GITHUB_REF_NAME}
ENV BUILD_TARGET=bun-linux-x64-musl

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

# App binary — musl target for Alpine runtime compatibility — plus manifest.json.
RUN bun run build.ts

# Supervisor — musl target to match the Alpine runtime base.
RUN bun build --compile --linux-x64-musl supervisor/index.ts --outfile=dist/supervisor


FROM --platform=linux/amd64 alpine:3.20
WORKDIR /data

COPY --from=build /app/dist/supervisor /supervisor
COPY --from=build /app/showflow /bootstrap/showflow
COPY --from=build /app/manifest.json /bootstrap/manifest.json

RUN apk add --no-cache su-exec \
    && addgroup --gid 65532 --system app \
    && adduser --uid 65532 --system --ingroup app -s /sbin/nologin app

ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000

VOLUME ["/data"]

USER app:app

CMD ["/supervisor"]
