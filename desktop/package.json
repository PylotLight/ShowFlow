{
  "name": "showfish",
  "productName": "Showfish",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only local viewer for a ShowFlow database backup",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "build:main": "bun build src/main.ts --target=node --format=cjs --external electron --outfile=dist/main.js",
    "build:server": "bun scripts/build-server.ts",
    "dev": "bun run build:main && electron .",
    "dist": "bun run build:main && bun run build:server && electron-builder --mac --arm64",
    "dist:dir": "bun run build:main && bun run build:server && electron-builder --mac dir --arm64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pylotlight.showfish",
    "productName": "Showfish",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        },
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    }
  }
}
